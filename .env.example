# Database
MONGO_URI=mongodb://localhost:27017/tenantflow

# Session (cookie-based; sign the httpOnly session cookie set on login)
SESSION_SECRET=your_session_secret_here

# App URL - used server-side for building links (verification emails,
# invite emails, Stripe success/cancel/return URLs)
APP_URL=http://localhost:3000

# Email (Brevo)
BREVO_API_KEY=your_brevo_key_here
BREVO_SENDER_EMAIL=onboarding@tenantflow.dev

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_FREE_PRICE_ID=
STRIPE_PRO_PRICE_ID=price_xxxxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxxxx

# AI generation (Gemini)
GEMINI_API_KEY=your_gemini_key_here
